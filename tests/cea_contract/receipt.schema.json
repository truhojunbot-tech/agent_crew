{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/truhojunbot-tech/alfred/tests/cea_contract/receipt.schema.json",
  "title": "CEA authorization receipt (ADR E11 r3 6cbce565 §3 + Π lifecycle/binding fields)",
  "description": "Shared contract between the alfred cron adapter and the agent_crew admission engine. Every §3 field and every Π field is required; a value the issuer cannot know is an explicit null or UNVERIFIED, never an omitted key. 'provenance' is the only non-§3 key and is optional. The agent_crew lineage (sev0/cea-lineage) copies this file byte-identically.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id", "issued_at", "issuer",
    "task_id", "intent_hash", "parent_receipt_id", "project",
    "authority_source", "policy_generation", "policy_hash", "source_decision_revs",
    "capability_registry", "matched_capability", "reuse",
    "runtime_state", "provider_budget",
    "required_reviewer", "required_tester", "human_gate_state",
    "caller_identity", "caller_provenance", "executor_binding", "executor_binding_status",
    "caller_identity_status", "downgrade_reason",
    "decision", "reason",
    "signature",
    "state", "binding", "idempotency_key", "attempt", "max_attempts", "dispatch_nonces", "supersedes"
  ],
  "properties": {
    "receipt_id": {"$ref": "#/$defs/uuid"},
    "issued_at": {"$ref": "#/$defs/rfc3339_utc"},
    "issuer": {"type": "string", "minLength": 1, "description": "engine instance id (runtime port + build commit)"},

    "task_id": {"type": "string", "minLength": 1},
    "intent_hash": {"$ref": "#/$defs/sha256"},
    "parent_receipt_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/uuid"}]},
    "project": {"type": "string", "minLength": 1},

    "authority_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_ids", "tier"],
      "properties": {
        "decision_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "tier": {"type": ["string", "null"]}
      }
    },
    "policy_generation": {"type": "integer", "minimum": 0},
    "policy_hash": {"type": "string", "minLength": 1},
    "source_decision_revs": {"$ref": "#/$defs/source_decision_revs"},
    "capability_registry": {"$ref": "#/$defs/capability_registry"},
    "matched_capability": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "owner", "repo"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "owner": {"type": ["string", "null"]},
            "repo": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "reuse": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "approved_by", "approver_identity_verified"],
          "properties": {
            "decision": {"enum": ["NEW", "REUSE", "EXTEND", null]},
            "approved_by": {},
            "approver_identity_verified": {"type": "boolean"}
          }
        }
      ]
    },

    "runtime_state": {"$ref": "#/$defs/runtime_state"},
    "provider_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "state", "observed_at"],
      "properties": {
        "provider": {"type": ["string", "null"]},
        "state": {"enum": ["OK", "CONSTRAINED", "EXHAUSTED", "UNVERIFIED"]},
        "observed_at": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/rfc3339_utc"}]}
      }
    },

    "required_reviewer": {"type": ["string", "null"], "description": "provider/identity class; must differ from executor_binding"},
    "required_tester": {"type": ["string", "null"]},
    "human_gate_state": {"$ref": "#/$defs/human_gate_state"},

    "caller_identity": {"type": ["string", "null"]},
    "caller_provenance": {"enum": ["cron", "direct", "coordinator", "manual", "cascade", "retry", "watchdog"]},
    "executor_binding": {"type": ["string", "null"]},
    "executor_binding_status": {"$ref": "#/$defs/verification"},
    "caller_identity_status": {"$ref": "#/$defs/verification"},
    "downgrade_reason": {"type": ["string", "null"]},

    "decision": {"enum": ["ALLOW", "BLOCK", "REVIEW", "HUMAN_GATE"]},
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "text"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "text": {"type": "string"}
      }
    },

    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "value", "status"],
      "description": "The engine's receipt signature (§3 integrity). Not the snapshot signature.",
      "properties": {
        "alg": {"type": ["string", "null"]},
        "key_id": {"type": ["string", "null"]},
        "value": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/verification"}
      }
    },

    "state": {"enum": ["ISSUED", "QUEUED", "CLAIMED", "RUNNING", "HELD", "CONSUMED", "SUPERSEDED", "REVOKED"]},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "description": "B (P3): the tuple re-validated at claim, dispatch and execute start.",
      "required": ["policy_generation", "policy_hash", "source_decision_revs", "capability_registry",
                   "matched_capability", "runtime_state", "runtime_state_epoch", "human_gate_state", "budget_class"],
      "properties": {
        "policy_generation": {"type": "integer", "minimum": 0},
        "policy_hash": {"type": "string", "minLength": 1},
        "source_decision_revs": {"$ref": "#/$defs/source_decision_revs"},
        "capability_registry": {"$ref": "#/$defs/capability_registry"},
        "matched_capability": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "owner"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "owner": {"type": ["string", "null"]}
              }
            }
          ]
        },
        "runtime_state": {"$ref": "#/$defs/runtime_state"},
        "runtime_state_epoch": {"type": "integer", "minimum": 0},
        "human_gate_state": {"$ref": "#/$defs/human_gate_state"},
        "budget_class": {"enum": ["OK", "CONSTRAINED", "EXHAUSTED"]}
      }
    },
    "idempotency_key": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "max_attempts": {"type": "integer", "minimum": 1},
    "dispatch_nonces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nonce", "attempt", "issued_at", "used_at"],
        "properties": {
          "nonce": {"type": "string", "minLength": 1},
          "attempt": {"type": "integer", "minimum": 1},
          "issued_at": {"$ref": "#/$defs/rfc3339_utc"},
          "used_at": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/rfc3339_utc"}]}
        }
      }
    },
    "supersedes": {"type": "array", "items": {"$ref": "#/$defs/uuid"}},

    "provenance": {
      "type": "object",
      "description": "Optional, non-§3: recorded, never an admission input (snapshot_signature_status, named coordinator, ...).",
      "properties": {
        "snapshot_signature_status": {"type": ["string", "null"]},
        "coordinator": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "rfc3339_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "verification": {"enum": ["VERIFIED", "UNVERIFIED"]},
    "runtime_state": {"enum": ["ACTIVE", "DRAINING", "QUARANTINED", "STOPPED"]},
    "source_decision_revs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "body_hash"],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1},
          "body_hash": {"type": "string", "minLength": 1}
        }
      }
    },
    "capability_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "hash"],
      "properties": {
        "generation": {"type": ["integer", "null"]},
        "hash": {"type": ["string", "null"]}
      }
    },
    "human_gate_state": {
      "anyOf": [
        {"enum": ["NOT_REQUIRED", "PENDING", "DENIED"]},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "decision_id"],
          "properties": {
            "state": {"const": "GRANTED"},
            "decision_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
